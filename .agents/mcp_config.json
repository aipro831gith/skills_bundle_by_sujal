{
  "mcpServers": {

    "filesystem-workspace": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${workspaceRoot}"],
      "env": {},
      "toolExecutionPolicy": "always-proceed",
      "description": "Workspace file read/write. Used by all builder agents."
    },

    "ast-parser": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${workspaceRoot}"],
      "env": {
        "AST_MODE": "typescript",
        "TS_CONFIG": "${workspaceRoot}/2_MAIN_CODING_FILES/tsconfig.json"
      },
      "toolExecutionPolicy": "always-proceed",
      "description": "AST symbol extraction for ast_diff_reconciler_skill. Finds function/class line numbers for offset-corrected diff application. Read-only — never modifies source."
    },

    "postgres-analytics": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "${POSTGRES_ANALYTICS_URL}"],
      "env": {
        "POSTGRES_ANALYTICS_URL": "${POSTGRES_ANALYTICS_URL}"
      },
      "toolExecutionPolicy": "request-review",
      "description": "Analytics PostgreSQL. SELECTs: always-proceed. Any write/DDL: request-review.",
      "toolPolicies": {
        "query": {
          "readPattern": "^\\s*(SELECT|EXPLAIN|SHOW)",
          "readPolicy": "always-proceed",
          "writePolicy": "request-review"
        }
      }
    },

    "github-enterprise": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "toolExecutionPolicy": "request-review",
      "description": "GitHub repo management. Reads: always-proceed. Writes/pushes/merges: request-review.",
      "toolPolicies": {
        "get_file_contents": { "policy": "always-proceed" },
        "list_repos": { "policy": "always-proceed" },
        "search_repositories": { "policy": "always-proceed" },
        "list_pull_requests": { "policy": "always-proceed" },
        "get_pull_request": { "policy": "always-proceed" },
        "create_or_update_file": { "policy": "request-review" },
        "push_files": { "policy": "request-review" },
        "create_pull_request": { "policy": "request-review" },
        "delete_branch": { "policy": "request-review" },
        "merge_pull_request": { "policy": "request-review" }
      }
    },

    "docker-sandbox": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-docker"],
      "env": {
        "DOCKER_HOST": "${DOCKER_HOST:-unix:///var/run/docker.sock}",
        "SANDBOX_MEMORY_LIMIT": "512m",
        "SANDBOX_CPU_LIMIT": "1.0",
        "SANDBOX_NETWORK": "none"
      },
      "toolExecutionPolicy": "proceed-in-sandbox",
      "description": "Isolated Docker execution for builds, test runs, and SAST scans. Network disabled in sandbox. Container removal requires request-review.",
      "toolPolicies": {
        "run_container": { "policy": "proceed-in-sandbox" },
        "build_image": { "policy": "proceed-in-sandbox" },
        "exec_in_container": { "policy": "proceed-in-sandbox" },
        "remove_container": { "policy": "request-review" },
        "remove_image": { "policy": "request-review" },
        "pull_image": { "policy": "request-review" }
      }
    },

    "sast-semgrep": {
      "transport": "stdio",
      "command": "semgrep",
      "args": ["--mcp"],
      "env": {
        "SEMGREP_APP_TOKEN": "${SEMGREP_APP_TOKEN}"
      },
      "toolExecutionPolicy": "always-proceed",
      "description": "Semgrep SAST — OWASP Top 10, secrets, SQL injection, XSS. Read-only. Used by deterministic_gatekeeper_skill (SECURITY gate) and sec_ops_skill.",
      "defaultArgs": [
        "--config=p/owasp-top-ten",
        "--config=p/secrets",
        "--config=p/sql-injection",
        "--config=p/xss",
        "--error",
        "--json"
      ]
    },

    "sast-trivy": {
      "transport": "stdio",
      "command": "trivy",
      "args": ["--cache-dir", "${workspaceRoot}/.trivy-cache"],
      "env": {},
      "toolExecutionPolicy": "always-proceed",
      "description": "Trivy vulnerability scanner — filesystem + container image scanning for HIGH/CRITICAL CVEs. Read-only. Used by deterministic_gatekeeper_skill (SECURITY gate T3)."
    },

    "test-runner-jest": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "jest",
        "--json",
        "--coverage",
        "--coverageReporters=json",
        "--forceExit"
      ],
      "env": {
        "NODE_ENV": "test"
      },
      "toolExecutionPolicy": "proceed-in-sandbox",
      "description": "Jest test runner with JSON output and coverage reporting. Used by deterministic_gatekeeper_skill (QA gate) to enforce 85% branch/line coverage. Results piped to .gate/jest_results.json."
    },

    "test-runner-pytest": {
      "transport": "stdio",
      "command": "python",
      "args": [
        "-m", "pytest",
        "--tb=short",
        "-q",
        "--cov=.",
        "--cov-fail-under=85",
        "--json-report",
        "--json-report-file=.gate/pytest_results.json"
      ],
      "env": {
        "PYTHONPATH": "${workspaceRoot}"
      },
      "toolExecutionPolicy": "proceed-in-sandbox",
      "description": "Pytest test runner with coverage enforcement (≥85%). Used by deterministic_gatekeeper_skill for Python projects."
    },

    "sequential-thinking": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "env": {},
      "toolExecutionPolicy": "always-proceed",
      "description": "Structured multi-step reasoning for Team Leader (Agent 00) and Architecture Agent (Agent 03) during /plan mode."
    },

    "brave-search": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      },
      "toolExecutionPolicy": "always-proceed",
      "description": "Web search for Research Agent (Agent 01). CVE lookups, library version checks, competitor research. Read-only."
    }

  }
}
