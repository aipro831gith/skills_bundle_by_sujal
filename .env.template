# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the required values.
# NEVER commit .env to version control.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL with PgBouncer / Connection Limit)
DATABASE_URL="postgresql://postgres:password@localhost:5432/app_db?schema=public&connection_limit=10"
POSTGRES_ANALYTICS_URL="postgresql://postgres:password@localhost:5432/analytics_db?schema=public"

# Authentication & Cryptography
# Generate RSA-2048 keys: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# CORS Security (Comma-separated exact origins)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# External API & Search Integration (Optional)
BRAVE_API_KEY=""
GITHUB_PERSONAL_ACCESS_TOKEN=""
SEMGREP_APP_TOKEN=""

# Mobile Deployment (Android / iOS)
KEYSTORE_PATH=""
KEY_ALIAS=""
STORE_PASSWORD=""
KEY_PASSWORD=""
APP_STORE_API_KEY_ID=""
APP_STORE_API_ISSUER_ID=""
